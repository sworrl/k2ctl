#!/bin/sh /etc/rc.common
# k2ctl: printer control service (Moonraker + Creality device socket -> web UI/API)
# Installed by deploy/deploy.sh to /etc/init.d/k2ctl on the K2 (OpenWrt/procd).
START=99
STOP=10
USE_PROCD=1

K2CTL_DIR=/mnt/UDISK/k2ctl

start_service() {
    # /mnt/UDISK mounts late at boot. The command line (and the TLS decision) is fixed when
    # this runs, so wait for the disk or k2ctl comes up HTTP-only until the next restart.
    for i in $(seq 1 60); do [ -x "$K2CTL_DIR/k2ctl" ] && break; sleep 2; done
    TLS_ARGS=""
    if [ -f "$K2CTL_DIR/tls/fullchain.pem" ] && [ -f "$K2CTL_DIR/tls/privkey.pem" ]; then
        TLS_ARGS="-tls-listen :443 -tls-cert $K2CTL_DIR/tls/fullchain.pem -tls-key $K2CTL_DIR/tls/privkey.pem"
    fi
    procd_open_instance
    procd_set_param command "$K2CTL_DIR/k2ctl" -listen :8085 -profiles "$K2CTL_DIR/profiles.json" $TLS_ARGS
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param nice 5
    procd_close_instance
}
