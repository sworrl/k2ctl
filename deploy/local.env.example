# Copy to deploy/local.env (git ignores it) and fill in. The deploy scripts read it so
# you don't have to pass the printer's address every time.
K2_IP=192.168.1.50                 # the printer, Settings > Network on the touchscreen
# Only for deploy/push-cert.sh and deploy/install-443.sh (HTTPS on your LAN):
#K2_CERT_NAME=k2.example.lan       # hostname your certificate is for; point it at the LAN IP
#K2_SSH_USER=yourname              # desktop user whose SSH key reaches the printer
